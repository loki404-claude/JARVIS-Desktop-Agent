# Is file ko .env naam se copy karo aur apni keys daalo. .env kisi ko mat bhejo.
GROQ_API_KEY=
GEMINI_API_KEY=
# Web search (https://tavily.com). Khali chhodo to sirf ddgs chalega.
TAVILY_API_KEY=

# ---- Groq models
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# ---- Gemini models
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ---- Personal settings
USER_NAME=Boss
DEFAULT_CITY=Delhi
# Aawaz: hi-IN-MadhurNeural (male) / hi-IN-SwaraNeural (female)
TTS_VOICE=hi-IN-MadhurNeural
# hi, en, ya auto
STT_LANGUAGE=hi
WAKE_WORD=jarvis
# hindi = jawab Devanagari mein (aawaz saaf), hinglish = Roman Hindi
REPLY_SCRIPT=hindi
# Jo naam/shabd galat likhe jaate hain, comma se: Rahul, Spotify, Lucknow
STT_WORDS=
# Khali = default mic. mic_test.py se number dekho
MIC_DEVICE=
# Mic dheemi aawaz na pakde to 1.5 karo; zyada shor pakde to 0.7
MIC_SENSITIVITY=1.0
